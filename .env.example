# All providers default to the offline "mock" implementation, so the project
# runs and tests pass with NO keys set. Set these only to use real providers.

# Embedding provider: mock | openai   (default: mock)
RAG_EMBED_PROVIDER=mock

# LLM provider: mock | openai          (default: mock)
RAG_LLM_PROVIDER=mock

# Required only when a provider above is set to "openai".
OPENAI_API_KEY=
